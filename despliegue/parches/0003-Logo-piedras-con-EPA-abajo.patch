From 60a8ac45bda57b7701ee111491caaabd8154171d Mon Sep 17 00:00:00 2001
From: EPA Bienestar <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 13:51:03 +0000
Subject: [PATCH] =?UTF-8?q?Logo:=20piedras=20con=20=C2=ABEPA=C2=BB=20abajo?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- assets/img/logo.svg: original vectorial (las tres piedras de la marca,
  sin el fondo blanco del archivo anterior, y «EPA» en Archivo 800
  convertido a trazos, en el azul de la piedra superior #317A9A).
- assets/img/logo.png: 486×512, fondo transparente (encabezado, footer,
  og:image).
- assets/img/favicon.ico: 16/32/48, solo las piedras.
- epa.css: el logo del encabezado pasa de 32×32 a 46 px de alto (40 en
  móvil) para que «EPA» se lea; el del footer, de 34×34 fijo (deformaba
  imágenes no cuadradas) a 54 px de alto con ancho automático.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01YbaShAJbLxRXJjMXbAiDWa
---
 LEEME.md               |   6 ++++--
 assets/css/epa.css     |   5 +++--
 assets/img/favicon.ico | Bin 0 -> 4348 bytes
 assets/img/logo.png    | Bin 0 -> 14670 bytes
 assets/img/logo.svg    |   4 ++++
 5 files changed, 11 insertions(+), 4 deletions(-)
 create mode 100644 assets/img/favicon.ico
 create mode 100644 assets/img/logo.png
 create mode 100644 assets/img/logo.svg

diff --git a/LEEME.md b/LEEME.md
index 5e3669e..3c112ab 100644
--- a/LEEME.md
+++ b/LEEME.md
@@ -6,8 +6,10 @@ Subí todo el contenido de esta carpeta a la raíz del sitio. Son archivos
 estáticos: no hace falta build step ni servidor de aplicaciones.
 
 **Importante:** copiá tu carpeta `assets/img/` actual dentro de `assets/`.
-No la incluimos acá para no pisar tus imágenes existentes. El sitio espera
-al menos `logo.png`, `favicon.ico` y `8pasos_AHA.jpg`.
+El repo trae solo la marca —`logo.svg` (piedras + «EPA», original vectorial),
+`logo.png` (486×512, fondo transparente) y `favicon.ico` (16/32/48, solo
+piedras: a ese tamaño el texto no se lee)—; el resto de las imágenes no, para
+no pisar las existentes. Falta todavía `8pasos_AHA.jpg`.
 
 ## Estructura
 
diff --git a/assets/css/epa.css b/assets/css/epa.css
index 3220aec..491b4ae 100644
--- a/assets/css/epa.css
+++ b/assets/css/epa.css
@@ -172,7 +172,7 @@ img { max-width: 100%; display: block; }
 .hdr-in { display: flex; align-items: center; gap: 26px; height: 68px; }
 
 .brand { display: flex; align-items: center; gap: 11px; text-decoration: none; flex: none; }
-.brand img { width: 32px; height: 32px; object-fit: contain; }
+.brand img { width: auto; height: 46px; object-fit: contain; }   /* logo con «EPA» abajo: se lee desde ~44 px */
 .brand-tx { display: flex; flex-direction: column; line-height: 1.05; }
 .brand-tx b { font-family: var(--f-display); font-weight: 800; font-size: 1.02rem; letter-spacing: -.03em; }
 .brand-tx span {
@@ -458,7 +458,7 @@ svg .ax-t { fill: var(--muted); font-family: var(--f-mono); font-size: 9.5px; le
 .ft address { font-style: normal; font-size: .9rem; color: var(--ink-2); line-height: 1.75; }
 
 .ft-brand { display: flex; align-items: center; gap: 11px; margin-bottom: 16px; }
-.ft-brand img { width: 34px; height: 34px; }
+.ft-brand img { width: auto; height: 54px; }
 .ft-tag { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .13em; text-transform: uppercase; color: var(--teal); }
 
 .status { display: inline-flex; align-items: center; gap: 9px; font-family: var(--f-mono); font-size: 11px; letter-spacing: .06em; color: var(--muted); margin-top: 18px; }
@@ -519,6 +519,7 @@ svg .ax-t { fill: var(--muted); font-family: var(--f-mono); font-size: 9.5px; le
   .burger { display: grid; place-items: center; }
   .hdr-act .btn-solid { display: none; }
   .brand-tx span { font-size: 8px; letter-spacing: .13em; }
+  .brand img { height: 40px; }
   .band { padding: 68px 0; }
   .head { margin-bottom: 38px; }
   .gap-grid, .dims, .svc, .news, .std, .grp, .team { grid-template-columns: 1fr; }
